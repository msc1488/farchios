{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/usr/local/share/farchios/branding/logo.txt",
    "type": "raw",
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  →  ",
    "key": { "width": 12 }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "de",
    "wm",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "colors"
  ]
}
