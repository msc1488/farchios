#!/usr/bin/env bash
# FarchiOs GPU setup — safe for hybrid Intel/AMD/NVIDIA systems.
set -Eeuo pipefail

if (( EUID != 0 )); then
    echo "Запусти через sudo: sudo farchios gpu" >&2
    exit 1
fi

for cmd in lspci pacman; do
    command -v "$cmd" >/dev/null 2>&1 || {
        echo "Не найдена команда: $cmd (проверь пакет pciutils/pacman)." >&2
        exit 1
    }
done

mapfile -t GPUS < <(lspci -nn 2>/dev/null | grep -Ei 'vga|3d|display' || true)
if (( ${#GPUS[@]} == 0 )); then
    echo "GPU не найден через lspci." >&2
    exit 1
fi

printf 'Найдено видеоустройств: %d\n' "${#GPUS[@]}"
printf '  %s\n' "${GPUS[@]}"

has_nvidia=0
has_nvidia_legacy=0
has_amd=0
has_intel=0
for gpu in "${GPUS[@]}"; do
    if [[ "$gpu" == *"[10de:"* ]]; then
        # Arch's current open kernel module supports Turing (GTX 16/RTX 20)
        # and newer. Pascal/Maxwell/older require a legacy driver branch.
        if grep -Eqi 'GTX? (3|4|5|6|7|8|9|10)[0-9]{2}|GeForce (3|4|5|6|7|8|9|10)[0-9]{2}M?|Quadro [KMP][0-9]|Tesla|NVS' <<<"$gpu"; then
            has_nvidia_legacy=1
        else
            has_nvidia=1
        fi
    fi
    [[ "$gpu" == *"[1002:"* ]] && has_amd=1
    [[ "$gpu" == *"[8086:"* ]] && has_intel=1
done

pkgs=()
if (( has_nvidia )); then
    pkgs+=(nvidia-open-dkms nvidia-utils nvidia-settings lib32-nvidia-utils libva-nvidia-driver linux-headers)
fi
if (( has_nvidia_legacy )); then
    echo "Обнаружена старая NVIDIA: официальный open-модуль Arch её не поддерживает."
    echo "Оставляю открытый драйвер Nouveau из профиля установки; автоматическую замену не выполняю."
    pkgs+=(vulkan-nouveau lib32-vulkan-nouveau)
fi
if (( has_amd )); then
    pkgs+=(mesa lib32-mesa vulkan-radeon lib32-vulkan-radeon
           libva-mesa-driver lib32-libva-mesa-driver radeontop)
fi
if (( has_intel )); then
    pkgs+=(mesa lib32-mesa vulkan-intel lib32-vulkan-intel
           intel-media-driver libva-intel-driver)
fi

if (( ${#pkgs[@]} == 0 )); then
    echo "Не удалось определить подходящий набор GPU-пакетов. Ничего не устанавливалось." >&2
    exit 1
fi

# Arch не поддерживает частичные обновления: обновляем систему вместе с пакетами.
echo "Обновляю систему и устанавливаю подходящие драйверы..."
pacman -Syu --needed --noconfirm "${pkgs[@]}"

if (( has_nvidia )); then
    install -d -m 755 /etc/modprobe.d
    cat > /etc/modprobe.d/farchios-nvidia.conf <<'EOF'
options nvidia NVreg_PreserveVideoMemoryAllocations=1
options nvidia_drm modeset=1
EOF

    # Сервисы присутствуют не во всех вариантах пакетов/драйверов.
    for unit in nvidia-suspend.service nvidia-hibernate.service nvidia-resume.service; do
        if systemctl list-unit-files "$unit" --no-legend 2>/dev/null | grep -q "$unit"; then
            systemctl enable "$unit"
        fi
    done
fi

if command -v mkinitcpio >/dev/null 2>&1; then
    mkinitcpio -P
fi

echo
echo "Драйверы установлены. Перезагрузи компьютер: sudo reboot"
