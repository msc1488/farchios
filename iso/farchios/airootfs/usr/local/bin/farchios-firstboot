#!/usr/bin/env bash
# FarchiOs first boot: retry on next boot if network/setup fails.
set -Eeuo pipefail

MARKER=/etc/farchios/firstboot.done
LOG=/var/log/farchios-firstboot.log
install -d -m 755 /etc/farchios
[[ -e "$MARKER" ]] && exit 0

exec > >(tee -a "$LOG") 2>&1
echo "=== FarchiOs first boot: $(date -Is) ==="

# Wait for DNS/network readiness. No marker is written if offline, so next boot retries.
for _ in $(seq 1 45); do
    if getent ahosts archlinux.org >/dev/null 2>&1; then
        break
    fi
    sleep 2
done

if ! getent ahosts archlinux.org >/dev/null 2>&1; then
    echo "Сеть недоступна. Настрой интернет и перезагрузи систему для повтора."
    exit 1
fi

echo "→ Настройка драйверов GPU"
/usr/local/bin/farchios-gpu-setup

echo "→ Применение игрового профиля"
/usr/local/bin/farchios tune

if getent group gamemode >/dev/null 2>&1; then
    while IFS=: read -r username _ uid _ _ home _; do
        if [[ "$uid" -ge 1000 && "$uid" -lt 60000 && "$home" == /home/* ]]; then
            usermod -aG gamemode "$username"
        fi
    done < /etc/passwd
fi

cat > /etc/motd <<'EOF'

  FarchiOs — игровая система на базе Arch Linux
  ─────────────────────────────────────────────
  farchios welcome   что делать дальше
  farchios doctor    проверить игровой стек
  farchios update    обновить систему

EOF

touch "$MARKER"
echo "=== Первый запуск успешно завершён: $(date -Is) ==="
