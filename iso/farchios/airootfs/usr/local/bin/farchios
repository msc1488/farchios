#!/usr/bin/env bash
# ============================================================
#  farchios — единая утилита FarchiOs
#  Использование: farchios <команда> [аргументы]
# ============================================================
set -Eeuo pipefail

FARCHIOS_VERSION="0.1.0-alpha"
FARCHIOS_CODENAME="forge"

if [[ -t 1 ]]; then
    B=$'\e[1m'; DIM=$'\e[2m'; R=$'\e[0m'
    ORANGE=$'\e[38;5;208m'; GREEN=$'\e[32m'; YELLOW=$'\e[33m'; RED=$'\e[31m'; BLUE=$'\e[34m'
else
    B=""; DIM=""; R=""; ORANGE=""; GREEN=""; YELLOW=""; RED=""; BLUE=""
fi

ok()   { printf '%s✓%s %s\n' "$GREEN" "$R" "$*"; }
warn() { printf '%s!%s %s\n' "$YELLOW" "$R" "$*"; }
err()  { printf '%s✗%s %s\n' "$RED" "$R" "$*" >&2; }
info() { printf '%s·%s %s\n' "$BLUE" "$R" "$*"; }
hr()   { printf '%s\n' "────────────────────────────────────────────────────────"; }

need_root() {
    if [[ ${EUID} -ne 0 ]]; then
        err "Нужны права root. Запусти: sudo farchios $*"
        exit 1
    fi
}

have() { command -v "$1" >/dev/null 2>&1; }
pkg_installed() { pacman -Q "$1" >/dev/null 2>&1; }

# ---------------------------------------------------------------- banner
cmd_banner() {
    printf '%s' "$ORANGE"
    cat <<'EOF'
   ____                 _     _    ___
  / __/__ _ _ __ ___| |__ (_)  / _ \  ___
 / _// _` | '__/ __| '_ \| | | | | |/ __|
/ /_| (_| | | | (__| | | | | | |_| |\__ \
\____\__,_|_|  \___|_| |_|_|  \___/ |___/
EOF
    printf '%s' "$R"
    printf '  %s%s «%s»%s\n' "$B" "$FARCHIOS_VERSION" "$FARCHIOS_CODENAME" "$R"
    printf '  %sИгровая система на базе Arch Linux%s\n\n' "$DIM" "$R"
}

# ---------------------------------------------------------------- help
cmd_help() {
    cmd_banner
    cat <<EOF
${B}КОМАНДЫ${R}
  ${ORANGE}welcome${R}        интерактивное приветствие / что делать дальше
  ${ORANGE}info${R}           версия, ядро, GPU, DE, состояние тюнинга
  ${ORANGE}doctor${R}         диагностика игрового стека (vulkan, proton, драйверы)
  ${ORANGE}doctor --fix${R}   диагностика + попытка исправить найденное
  ${ORANGE}gpu${R}            определить GPU и поставить нужные драйверы
  ${ORANGE}tune${R}           применить игровой тюнинг (sysctl, zram, сервисы)
  ${ORANGE}gaming${R}        доустановить/проверить игровой стек
  ${ORANGE}aur${R}           установить AUR-хелпер paru
  ${ORANGE}proton${R}        подсказка и установка Proton-GE
  ${ORANGE}install${R}       установка FarchiOs на диск (из live-режима)
  ${ORANGE}update${R}        полное обновление системы
  ${ORANGE}version${R}       только версия

${B}ПРИМЕРЫ${R}
  farchios info
  sudo farchios gpu
  sudo farchios tune
  farchios doctor
EOF
}

# ---------------------------------------------------------------- info
cmd_info() {
    local kernel gpu de session
    kernel=$(uname -r)
    gpu=$(lspci -nn 2>/dev/null | grep -Ei 'vga|3d|display' | sed 's/^[^:]*: //' | head -n1 || true)
    de="${XDG_CURRENT_DESKTOP:-${DESKTOP_SESSION:-неизвестно}}"
    session="${XDG_SESSION_TYPE:-неизвестно}"

    cmd_banner
    printf '%sСистема%s\n' "$B" "$R"
    printf '  Дистрибутив : %sFarchiOs %s «%s»%s\n' "$B" "$FARCHIOS_VERSION" "$FARCHIOS_CODENAME" "$R"
    printf '  Ядро        : %s\n' "$kernel"
    printf '  GPU         : %s\n' "${gpu:-не определён}"
    printf '  Сессия      : %s / %s\n' "$de" "$session"
    printf '  Пакетов     : %s\n' "$(pacman -Qq 2>/dev/null | wc -l)"

    hr
    printf '%sТюнинг%s\n' "$B" "$R"
    if [[ -f /etc/sysctl.d/99-farchios-gaming.conf ]]; then
        ok "sysctl-профиль применён"
    else
        warn "sysctl-профиль отсутствует (sudo farchios tune)"
    fi
    if compgen -G "/dev/zram*" >/dev/null; then
        ok "zram активен ($(zramctl --output=NAME,SIZE,DISKS --noheadings 2>/dev/null | head -n1))"
    else
        warn "zram не активен"
    fi
    if pkg_installed gamemode; then
        ok "GameMode установлен (активируется по запросу игры)"
    else
        warn "GameMode не установлен"
    fi
    for svc in irqbalance ananicy-cpp earlyoom; do
        if systemctl is-enabled "${svc}.service" >/dev/null 2>&1; then
            ok "сервис ${svc} включён"
        else
            warn "сервис ${svc} не включён"
        fi
    done
}

# ---------------------------------------------------------------- doctor
cmd_doctor() {
    local fix=0 problems=0 vendor="" nvidia_legacy=0
    [[ "${1:-}" == "--fix" ]] && fix=1

    hr
    printf '%sДиагностика FarchiOs%s\n' "$B" "$R"
    hr

    local pci
    pci="$(lspci -nn 2>/dev/null | grep -Ei 'vga|3d|display' || true)"
    if grep -qi '10de:' <<<"$pci"; then
        vendor="nvidia"
        if grep -Eqi 'GTX? (3|4|5|6|7|8|9|10)[0-9]{2}|GeForce (3|4|5|6|7|8|9|10)[0-9]{2}M?|Quadro [KMP][0-9]|Tesla|NVS' <<<"$pci"; then
            nvidia_legacy=1
        fi
    fi
    if grep -qi '1002:' <<<"$pci"; then vendor="${vendor:+$vendor+}amd"; fi
    if grep -qi '8086:' <<<"$pci"; then vendor="${vendor:+$vendor+}intel"; fi

    if [[ -z "$vendor" ]]; then
        warn "GPU не распознан — проверь lspci"
        problems=$((problems+1))
    else
        info "Обнаружены GPU: $vendor"
        if (( fix )); then
            /usr/local/bin/farchios-gpu-setup || warn "Автоустановка GPU-драйверов завершилась ошибкой"
        fi
        if [[ "$vendor" == *nvidia* ]]; then
            if (( nvidia_legacy )); then
                if pkg_installed vulkan-nouveau && pkg_installed lib32-vulkan-nouveau; then
                    ok "NVIDIA legacy: Vulkan Nouveau установлен"
                else
                    warn "NVIDIA legacy: не хватает Vulkan Nouveau"; problems=$((problems+1))
                fi
            elif pkg_installed nvidia-utils && { pkg_installed nvidia-open-dkms || pkg_installed nvidia-open || pkg_installed nvidia-dkms; }; then
                ok "NVIDIA: пользовательские библиотеки и модуль установлены"
            else
                warn "NVIDIA: не хватает драйвера или nvidia-utils"; problems=$((problems+1))
            fi
        fi
        if [[ "$vendor" == *amd* ]]; then
            if pkg_installed vulkan-radeon; then ok "AMD: Vulkan-драйвер установлен"
            else warn "AMD: нет vulkan-radeon"; problems=$((problems+1)); fi
        fi
        if [[ "$vendor" == *intel* ]]; then
            if pkg_installed vulkan-intel; then ok "Intel: Vulkan-драйвер установлен"
            else warn "Intel: нет vulkan-intel"; problems=$((problems+1)); fi
        fi
    fi

    if have vulkaninfo && vulkaninfo --summary &>/dev/null; then
        ok "Vulkan работает"
    else
        warn "Vulkan не отвечает (vulkaninfo --summary)"; problems=$((problems+1))
    fi

    if pkg_installed lib32-mesa || pkg_installed lib32-nvidia-utils; then
        ok "32-битные графические библиотеки установлены"
    else
        warn "Не найдены 32-битные графические библиотеки"; problems=$((problems+1))
    fi

    for p in steam lutris gamemode mangohud gamescope wine; do
        if pkg_installed "$p"; then
            ok "Пакет $p установлен"
        else
            warn "Пакет $p отсутствует"; problems=$((problems+1))
            if (( fix )); then
                pacman -Syu --needed --noconfirm "$p" || warn "Не удалось установить $p"
            fi
        fi
    done

    if (( fix )); then
        info "Повторная проверка после попытки исправления..."
        # Не запускаем повторно установку; итоговая проверка пакетов ниже.
        local remaining=0
        for p in steam lutris gamemode mangohud gamescope wine; do
            pkg_installed "$p" || remaining=$((remaining+1))
        done
        if (( remaining == 0 )); then
            ok "Игровые пакеты установлены"
        else
            warn "После исправления отсутствуют игровые пакеты: $remaining"
        fi
    fi

    hr
    if (( problems == 0 )); then
        ok "Критических проблем не обнаружено."
    else
        warn "Найдено проблем: $problems"
        (( fix )) || info "Запусти 'sudo farchios doctor --fix' для попытки исправления"
    fi
    (( problems == 0 ))
}

# ---------------------------------------------------------------- tune
cmd_tune() {
    need_root "$@"
    info "Применяю игровой профиль..."

    install -Dm644 /usr/local/share/farchios/sysctl/99-farchios-gaming.conf \
        /etc/sysctl.d/99-farchios-gaming.conf
    if sysctl -p /etc/sysctl.d/99-farchios-gaming.conf >/tmp/farchios-sysctl.log 2>&1; then
        ok "sysctl-профиль применён"
    else
        cat /tmp/farchios-sysctl.log >&2
        err "Не все параметры sysctl применились"
        return 1
    fi

    systemctl enable --now fstrim.timer
    ok "fstrim.timer включён"

    for svc in irqbalance ananicy-cpp earlyoom power-profiles-daemon; do
        if pkg_installed "$svc"; then
            if systemctl enable --now "${svc}.service"; then
                ok "включён ${svc}"
            else
                warn "Не удалось включить ${svc}"
            fi
        fi
    done

    if pkg_installed zram-generator; then
        systemctl daemon-reload
        if systemctl start dev-zram0.swap; then
            ok "zram запущен"
        else
            warn "zram не удалось запустить; проверь zram-generator.conf"
        fi
    fi

    # Не задаём глобально DXVK_HUD, NVAPI и лимит DXVK/VKD3D:
    # они меняют поведение игр и должны настраиваться пользователем отдельно.
    ok "Игровой профиль применён. Перезагрузка рекомендуется."
}

# ---------------------------------------------------------------- gaming
cmd_gaming() {
    need_root "$@"
    info "Устанавливаю игровой стек..."
    local pkgs=(steam lutris gamemode lib32-gamemode gamescope mangohud lib32-mangohud
                wine wine-mono winetricks vkd3d lib32-vkd3d obs-studio discord)
    pacman -Syu --needed --noconfirm "${pkgs[@]}"
    if getent group gamemode >/dev/null 2>&1; then
        local target_user="${SUDO_USER:-}"
        if [[ -n "$target_user" && "$target_user" != root ]]; then
            usermod -aG gamemode "$target_user"
            ok "Пользователь $target_user добавлен в группу gamemode (нужен повторный вход)"
        fi
    fi
    ok "Игровой стек установлен"
}

# ---------------------------------------------------------------- gpu
cmd_gpu() {
    need_root "$@"
    exec /usr/local/bin/farchios-gpu-setup
}

# ---------------------------------------------------------------- aur
cmd_aur() {
    local build_user="${SUDO_USER:-${USER:-}}"
    if [[ "$build_user" == "root" || -z "$build_user" ]]; then
        err "Запусти команду из обычной пользовательской сессии."
        return 1
    fi
    if have paru; then ok "paru уже установлен"; return 0; fi

    local tmp
    tmp="$(mktemp -d /tmp/farchios-paru.XXXXXX)"
    chown "$build_user":"$(id -gn "$build_user")" "$tmp"
    trap 'rm -rf "$tmp"' RETURN

    if (( EUID == 0 )); then
        pacman -Syu --needed --noconfirm base-devel git
        runuser -u "$build_user" -- git clone --depth=1 https://aur.archlinux.org/paru-bin.git "$tmp/paru-bin"
        runuser -u "$build_user" -- bash -c "cd '$tmp/paru-bin' && makepkg --noconfirm --needed"
        local pkg
        pkg="$(find "$tmp/paru-bin" -maxdepth 1 -type f -name 'paru-bin-*.pkg.tar.*' ! -name '*.sig' | head -n1)"
        [[ -n "$pkg" ]] || { err "makepkg не создал пакет paru"; return 1; }
        pacman -U --needed --noconfirm "$pkg"
    else
        sudo pacman -Syu --needed --noconfirm base-devel git
        git clone --depth=1 https://aur.archlinux.org/paru-bin.git "$tmp/paru-bin"
        ( cd "$tmp/paru-bin" && makepkg --noconfirm --needed )
        sudo pacman -U --needed --noconfirm "$tmp"/paru-bin/paru-bin-*.pkg.tar.*
    fi
    ok "paru установлен"
}

# ---------------------------------------------------------------- proton
cmd_proton() {
    cat <<'EOF'
Proton-GE (рекомендуется для игр вне Steam):

  1. Установи ProtonUp-Qt:
       paru -S protonup-qt
  2. Запусти ProtonUp-Qt → Add version → GE-Proton → Download
  3. Для Steam: Steam → Настройки → Совместимость →
     включить Steam Play для всех игр.

Автоматически (CLI):

  paru -S proton-ge-custom-bin
  mkdir -p ~/.steam/root/compatibilitytools.d
  ln -sf /usr/share/steam/compatibilitytools.d/GE-Proton* ~/.steam/root/compatibilitytools.d/
EOF
}

# ---------------------------------------------------------------- install
cmd_install() {
    need_root "$@"
    if [[ ! -d /run/archiso ]]; then
        err "Это не live-среда FarchiOs. Запускай из загруженного ISO."
        exit 1
    fi
    have archinstall || { err "archinstall не установлен"; exit 1; }
    have jq || { err "jq не установлен"; exit 1; }
    have base64 || { err "base64 не найден"; exit 1; }

    cat <<'EOF'
Установка FarchiOs на диск
──────────────────────────
Откроется Archinstall с заранее подготовленным профилем FarchiOs:
  • KDE Plasma + SDDM
  • PipeWire
  • multilib и игровой пакетный набор
  • фирменные команды FarchiOs и first-boot настройка
  • загрузчик будет выбран с учётом режима BIOS/UEFI

В Archinstall тебе останется выбрать диск, разметку, пользователя,
пароль и проверить итоговую конфигурацию.

ВНИМАНИЕ: выбранный диск может быть полностью очищен.
Ничего не подтверждай, пока не проверишь выбранный накопитель.
EOF
    read -r -p "Открыть установщик? [y/N] " answer
    [[ "${answer,,}" == "y" ]] || return 0

    local payload config packages_json bootloader gfx_driver
    config="$(mktemp /tmp/farchios-archinstall.XXXXXX.json)"
    trap 'rm -f "$config"' RETURN

    # Встраиваем системные файлы в custom_commands. Команда выполняется
    # archinstall внутри установленной системы (arch-chroot), а не в Live ISO.
    payload="$(
        tar -C "$PROFILE/airootfs" -czf - \
            usr/local/bin/farchios \
            usr/local/bin/farchios-firstboot \
            usr/local/bin/farchios-gpu-setup \
            usr/local/bin/farchios-postinstall \
            usr/local/share/farchios \
            etc/systemd/system/farchios-firstboot.service \
            etc/systemd/zram-generator.conf \
            etc/security/limits.d/99-farchios-gaming.conf \
            etc/udev/rules.d/60-farchios-iosched.rules \
        | base64 -w0
    )"

    packages_json="$(
        grep -vE '^[[:space:]]*(#|$)' "$PROFILE/packages.x86_64" |
            sed 's/[[:space:]]*#.*$//' |
            jq -Rsc 'split("\n") | map(select(length > 0))'
    )"

    if [[ -d /sys/firmware/efi ]]; then
        bootloader="systemd-bootctl"
    else
        bootloader="grub-install"
    fi
    gfx_driver="All open-source (default)"
    if lspci -nn 2>/dev/null | grep -Ei 'vga|3d|display' | grep -qi '10de:'; then
        if ! lspci 2>/dev/null | grep -Ei 'GTX? (3|4|5|6|7|8|9|10)[0-9]{2}|GeForce (3|4|5|6|7|8|9|10)[0-9]{2}M?|Quadro [KMP][0-9]|Tesla|NVS' >/dev/null; then
            gfx_driver="Nvidia (open kernel module for newer GPUs, Turing+)"
        fi
    fi

    jq -n \
        --arg payload "$payload" \
        --arg bootloader "$bootloader" \
        --arg gfx_driver "$gfx_driver" \
        --argjson packages "$packages_json" \
        '{
          "bootloader": $bootloader,
          "kernels": ["linux"],
          "mirror-region": {"Worldwide": {"https://geo.mirror.pkgbuild.com/$repo/os/$arch": true}},
          "additional-repositories": "multilib",
          "packages": $packages,
          "profile": {
            "main": "desktop",
            "details": "plasma",
            "gfx_driver": $gfx_driver,
            "greeter_type": "sddm"
          },
          "audio_config": {"audio": "pipewire"},
          "services": [
            "NetworkManager.service",
            "bluetooth.service",
            "sddm.service",
            "fstrim.timer",
            "NetworkManager-wait-online.service"
          ],
          "ntp": true,
          "custom_commands": [
            ("bash -c \u0027printf %s " + $payload +
             " | base64 -d | tar -xz -C / && chmod 755 /usr/local/bin/farchios /usr/local/bin/farchios-firstboot /usr/local/bin/farchios-gpu-setup /usr/local/bin/farchios-postinstall && systemctl enable farchios-firstboot.service\u0027")
          ]
        }' > "$config"

    info "Запускаю Archinstall с профилем FarchiOs..."
    archinstall --config "$config"
}

# ---------------------------------------------------------------- update
cmd_update() {
    need_root "$@"
    info "Обновляю систему (pacman -Syu)..."
    pacman -Syu --noconfirm
    if have paru && [[ -n "${SUDO_USER:-}" ]]; then
        info "Обновляю AUR-пакеты..."
        sudo -u "$SUDO_USER" paru -Sua --noconfirm
    fi
    ok "Готово. Перезагрузись, если обновилось ядро."
}

# ---------------------------------------------------------------- welcome
cmd_welcome() {
    cmd_banner
    cat <<EOF
${B}С чего начать${R}

  1. ${ORANGE}Подключись к сети${R}
       nmcli device wifi list && nmcli device wifi connect "<SSID>" password "<пароль>"

  2. ${ORANGE}Поставь драйверы GPU${R}
       sudo farchios gpu

  3. ${ORANGE}Примени тюнинг${R}
       sudo farchios tune

  4. ${ORANGE}Проверь систему${R}
       farchios doctor

  5. ${ORANGE}Установи на диск${R}
       sudo farchios install

${B}Полезное${R}
  • Proton-GE:  farchios proton
  • AUR:        farchios aur
  • MangoHud:   mangohud %command%   (в параметрах запуска Steam)
  • GameMode:   gamemoderun %command%
  • Gamescope:  gamescope -W 1920 -H 1080 -r 144 -- %command%
EOF
}

# ---------------------------------------------------------------- dispatch
case "${1:-help}" in
    help|-h|--help|"") cmd_help ;;
    welcome)            cmd_welcome ;;
    info)               cmd_info ;;
    doctor)             cmd_doctor "${2:-}" ;;
    gpu)                cmd_gpu "$@" ;;
    tune)               cmd_tune "$@" ;;
    gaming)             cmd_gaming "$@" ;;
    aur)                cmd_aur ;;
    proton)             cmd_proton ;;
    install)            cmd_install "$@" ;;
    update)             cmd_update "$@" ;;
    version|-v|--version) echo "FarchiOs $FARCHIOS_VERSION «$FARCHIOS_CODENAME»" ;;
    *) err "Неизвестная команда: $1"; echo; cmd_help; exit 1 ;;
esac
